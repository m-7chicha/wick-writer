{
  "name": "wick-writer",
  "private": true,
  "version": "1.0.0",
  "description": "A calm desktop writing sanctuary for drafting, visual mindstorming, and book studio previewing.",
  "author": "WICK",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "desktop:build": "npm run build && npm run build:server",
    "desktop:pack": "npm run desktop:build && electron-builder",
    "desktop:pack:linux": "npm run desktop:build && electron-builder --linux",
    "desktop:pack:win": "npm run desktop:build && electron-builder --win",
    "preview": "vite preview",
    "clean": "node -e \"['dist','dist-server','release','server.js'].forEach(p => require('node:fs').rmSync(p, {recursive:true, force:true}))\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@google/genai": "^2.4.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "esbuild@0.28.2": true
  }
}
